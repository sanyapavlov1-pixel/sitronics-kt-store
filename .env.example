# Application
APP_ID=sitronics-kt-store
APP_SECRET=replace-with-a-long-random-secret
PORT=3000

# MySQL / TiDB
DATABASE_URL=mysql://user:password@host:3306/sitronics_kt_store

# Administrator — use your own credentials, never commit real values
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Optional: platform object storage for admin image uploads.
# These values are injected automatically in the Kimi runtime.
KIMI_AGENTGW_API_KEY=
KIMI_AGENTGW_BASE_URL=
KIMI_STORAGE_RESOURCE_ID=
